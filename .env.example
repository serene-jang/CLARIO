# Local backend configuration. Copy to server/.env for local development.
PORT=4000
# Set all three values together to enable Google school authentication.
# Keep credentials in server/.env, never in frontend variables.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/clario
# GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
