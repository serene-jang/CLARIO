# Local backend configuration. Copy to server/.env for local development.
PORT=4000
# Opt-in built teacher/student hosting under /teacher/ and /student/.
SERVE_WEB=false
# Disposable generated-canvas experiment only; never real student screens.
# Requires non-production NODE_ENV and exclusively loopback HTTP APP_ORIGINS.
CLARIO_SYNTHETIC_MEDIA=false
# Optional PDF-only private disk storage, disabled when absent.
# Must be an absolute directory OUTSIDE this repository and every public web root.
# Windows example; use a private persistent mount on a Linux server instead.
# CLARIO_DOCUMENTS_DIR=C:\CLARIO-private\documents
# Restrict the directory to the API service account; approve backup/deletion policy before real data.
# Set DATABASE_URL and APP_ORIGINS together to enable public email/password accounts.
# GOOGLE_CLIENT_ID is optional and adds Google signup/login for personal or Workspace accounts.
# No school API, school domain restriction or school administrator registration is required.
# Keep credentials in server/.env, never in frontend variables.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/clario
# GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
